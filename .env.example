# Copy this file to .env and fill it in. Never commit .env.

# --- Brain: any OpenAI-compatible API ---
# Local Ollama (free, runs on your own machine). With docker compose's ollama service:
MODEL_BASE_URL=http://ollama:11434/v1
MODEL_NAME=qwen2.5:7b
MODEL_API_KEY=ollama
# Grok instead (paid):
# MODEL_BASE_URL=https://api.x.ai/v1
# MODEL_NAME=grok-4.3
# MODEL_API_KEY=xai-...

# --- Web chat login ---
# An argon2 hash of your chat page password; the password itself is never stored.
# Make it with:  python -m agent hash-password
# (in Docker:   docker compose run --rm agent python -m agent hash-password)
# and paste the whole line it prints, single quotes included.
AGENT_PASSWORD_HASH=
# Set to false only when testing on http://localhost. Online it must stay true (HTTPS).
COOKIE_SECURE=true
# How long a login lasts, in days, and how many hours unused before it ends anyway.
SESSION_DAYS=14
SESSION_IDLE_HOURS=72

# --- Safety ---
# Most model calls allowed per day (each tool step counts as one call).
DAILY_CALL_LIMIT=300
# Most tool steps for one message.
MAX_TOOL_STEPS=8

# Hostnames the page answers to, comma separated (e.g. agent.example.com). Empty allows any;
# set it once the agent is online.
ALLOWED_HOSTS=

# IP of your HTTPS reverse proxy as the agent sees it (with Docker often 172.17.0.1), comma
# separated, CIDRs allowed. Only these may report the real visitor IP. Empty means 127.0.0.1 and
# ::1. If you see a "FORWARDED_ALLOW_IPS" warning in the log, your proxy's IP is missing here.
# '*' trusts whoever connects directly (and then uses the right-most address); only use it when
# nothing but your proxy can reach the agent's port.
FORWARDED_ALLOW_IPS=

# Shell commands for the agent. OFF unless set to true. When on, commands run as the agent's own
# user, so a web page that tricks the model could use one against the agent itself. Never turn it
# on outside Docker or on your own computer.
ALLOW_SHELL=false

# --- Other ---
AGENT_NAME=Agent
TIMEZONE=Europe/Helsinki
DATA_DIR=/data
