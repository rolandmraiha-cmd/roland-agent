# v2 M2 edge configuration reference. No credentials belong in this file.
# Compose overrides production security/bind settings and keeps unfinished features off.
# The model runtime is implemented; provider/actions, full preflight/firewall and sidecars follow.
# ALLOW_SHELL, BROWSER_ENABLED and SCREEN_ENABLED stay off at this stage.
# For a local model outside Docker, set MODEL_BASE_URL=http://127.0.0.1:8080.
# AGENT_PASSWORD_HASH and MODEL_SERVER_TOKEN also work directly in .env for development.
# Mounted secrets take precedence; do not commit .env or the secrets/ directory.

# --- Host and web edge ---
# AGENT_ENV: v2 code default; see docs/v2-spec.md §11.1.
AGENT_ENV=development
# AGENT_DOMAIN: v2 code default; see docs/v2-spec.md §11.1.
AGENT_DOMAIN=
# AGENT_FALLBACK_HOST: v2 code default; see docs/v2-spec.md §11.1.
AGENT_FALLBACK_HOST=37-60-226-214.sslip.io
# AGENT_HOST: v2 code default; see docs/v2-spec.md §11.1.
AGENT_HOST=
# ACME_EMAIL: v2 code default; see docs/v2-spec.md §11.1.
ACME_EMAIL=
# CADDY_TLS: v2 code default; see docs/v2-spec.md §11.1.
CADDY_TLS=acme

# --- Local model (legacy /v1 completions until M2 provider replacement) ---
# MODEL_PROVIDER: v2 code default; see docs/v2-spec.md §11.1.
MODEL_PROVIDER=llamacpp
# Only approved http hosts resolving to loopback, RFC1918 or ULA addresses.
MODEL_BASE_URL=http://10.77.6.60:8080
# Host allowlist; adding a host never permits a public address.
MODEL_ALLOWED_HOSTS=10.77.6.60,model,127.0.0.1,localhost,::1
# MODEL_NAME: v2 code default; see docs/v2-spec.md §11.1.
MODEL_NAME=current
# MODEL_SERVER_TOKEN: read from a private mounted file (or environment in development).
# MODEL_SERVER_TOKEN_FILE=/run/secrets/model_server_token
# Reserved for M2 grammar/native providers; current protocol still uses native tool calls.
MODEL_TOOL_MODE=grammar
# MODEL_CTX: v2 Contabo default (4096); ceiling remains 6144. See docs/v2-spec.md §11.1.
MODEL_CTX=4096
# MODEL_MAX_NEW_TOKENS: v2 code default; see docs/v2-spec.md §11.1.
MODEL_MAX_NEW_TOKENS=768
# MODEL_TEMPERATURE: v2 code default; see docs/v2-spec.md §11.1.
MODEL_TEMPERATURE=0.2
# MODEL_TIMEOUT_S: v2 code default; see docs/v2-spec.md §11.1.
MODEL_TIMEOUT_S=600.0
# MODEL_MAX_CONCURRENCY: v2 code default; see docs/v2-spec.md §11.1.
MODEL_MAX_CONCURRENCY=3
# MODEL_PARSE_RETRIES: v2 code default; see docs/v2-spec.md §11.1.
MODEL_PARSE_RETRIES=2
# MODEL_HISTORY_MESSAGES: v2 code default; see docs/v2-spec.md §11.1.
MODEL_HISTORY_MESSAGES=12
# MODEL_TOOL_OUTPUT_CHARS: v2 code default; see docs/v2-spec.md §11.1.
MODEL_TOOL_OUTPUT_CHARS=3000
# MODEL_SYSTEM_PROMPT_BUDGET: v2 code default; see docs/v2-spec.md §11.1.
MODEL_SYSTEM_PROMPT_BUDGET=1500
# MODEL_THREADS: v2 code default; see docs/v2-spec.md §11.1.
MODEL_THREADS=3
# MODEL_MEM_LIMIT: v2 code default; see docs/v2-spec.md §11.1.
MODEL_MEM_LIMIT=3840m
# MODEL_CPUS: v2 code default; see docs/v2-spec.md §11.1.
MODEL_CPUS=3.0
# MODEL_VISION: v2 code default; see docs/v2-spec.md §11.1.
MODEL_VISION=false
# MODEL_KEEP_VERSIONS: v2 code default; see docs/v2-spec.md §11.1.
MODEL_KEEP_VERSIONS=3
# MODEL_IMPORT_MAX_MB: v2 code default; see docs/v2-spec.md §11.1.
MODEL_IMPORT_MAX_MB=6144

# --- Training (M8; parsed settings only, both opt-ins remain off) ---
# TRAINING_CAPTURE: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_CAPTURE=false
# TRAINING_LOOP_ENABLED: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_LOOP_ENABLED=false
# TRAINING_SCHEDULE: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_SCHEDULE='0 3 * * 0'
# TRAINING_LAUNCH_MODE: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_LAUNCH_MODE=manual
# TRAINING_SSH_TARGET: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_SSH_TARGET=
# TRAINING_SSH_KNOWN_HOSTS: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_SSH_KNOWN_HOSTS=
# TRAINING_PROVIDER: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_PROVIDER=
# TRAINING_MAX_HOURS: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_MAX_HOURS=4
# TRAINING_MIN_NEW_SFT: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_MIN_NEW_SFT=50
# TRAINING_MIN_NEW_PAIRS: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_MIN_NEW_PAIRS=20
# TRAINING_SEED_RATIO: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_SEED_RATIO=0.3
# TRAINING_KEEP_EMAILS: v2 code default; see docs/v2-spec.md §11.1.
TRAINING_KEEP_EMAILS=
# TRAINER_URL: v2 code default; see docs/v2-spec.md §11.1.
TRAINER_URL=http://10.77.7.70:7200
# TRAINER_API_TOKEN: read from a private mounted file (or environment in development).
# TRAINER_API_TOKEN_FILE=/run/secrets/trainer_api_token

# --- Web login, sessions and limits ---
# AGENT_PASSWORD_HASH: read from a private mounted file (or environment in development).
# AGENT_PASSWORD_HASH_FILE=/run/secrets/agent_password_hash
# Must be true in production; false only for local HTTP development.
COOKIE_SECURE=true
# SESSION_DAYS: v2 code default; see docs/v2-spec.md §11.1.
SESSION_DAYS=14
# SESSION_IDLE_HOURS: v2 code default; see docs/v2-spec.md §11.1.
SESSION_IDLE_HOURS=72.0
# DAILY_CALL_LIMIT: v2 code default; see docs/v2-spec.md §11.1.
DAILY_CALL_LIMIT=300
# Conservative server limit for the local model (the code default remains 8).
MAX_TOOL_STEPS=6
# AGENT_NAME: v2 code default; see docs/v2-spec.md §11.1.
AGENT_NAME=Agent
# TIMEZONE: v2 code default; see docs/v2-spec.md §11.1.
TIMEZONE=Europe/Helsinki
# Comma list; empty defaults to AGENT_HOST. Required in production.
ALLOWED_HOSTS=
# Explicit reverse proxy IPs/CIDRs. Wildcards and /0 are refused.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# --- Bind address and workspace (workspace quotas come in M5) ---
# CORE_ALLOWED_PEERS: v2 code default; see docs/v2-spec.md §11.1.
CORE_ALLOWED_PEERS=
# HOST: v2 code default; see docs/v2-spec.md §11.1.
HOST=0.0.0.0
# PORT: v2 code default; see docs/v2-spec.md §11.1.
PORT=8080
# Database directory. /data is the current Docker volume; use ./data outside Docker.
DATA_DIR=/data
# Empty uses DATA_DIR/workspace.
WORKSPACE_DIR=
# Must already exist, uid 1000/mode 0700. Full quota setup arrives with deploy scripts.
WORKSPACE_HOST_DIR=/srv/roland-agent/workspace
# WORKSPACE_QUOTA_MB: v2 code default; see docs/v2-spec.md §11.1.
WORKSPACE_QUOTA_MB=8192
# WORKSPACE_RESERVE_MB: v2 code default; see docs/v2-spec.md §11.1.
WORKSPACE_RESERVE_MB=256
# WORKSPACE_MAX_FILES: v2 code default; see docs/v2-spec.md §11.1.
WORKSPACE_MAX_FILES=50000
# UPLOAD_MAX_MB: v2 code default; see docs/v2-spec.md §11.1.
UPLOAD_MAX_MB=100
# TRASH_KEEP_DAYS: v2 code default; see docs/v2-spec.md §11.1.
TRASH_KEEP_DAYS=7

# --- Shell and sandbox (sandbox service comes in M4) ---
# Off by default. Production refuses the current local shell backend.
ALLOW_SHELL=false
# local or sandbox; startup refuses enabled sandbox until M4.
SHELL_BACKEND=local
# SHELL_APPROVAL: v2 code default; see docs/v2-spec.md §11.1.
SHELL_APPROVAL=tainted
# SHELL_TIMEOUT_DEFAULT: v2 code default; see docs/v2-spec.md §11.1.
SHELL_TIMEOUT_DEFAULT=60
# SHELL_TIMEOUT_MAX: v2 code default; see docs/v2-spec.md §11.1.
SHELL_TIMEOUT_MAX=300
# SANDBOX_URL: v2 code default; see docs/v2-spec.md §11.1.
SANDBOX_URL=http://10.77.3.20:7000
# SANDBOX_API_TOKEN: read from a private mounted file (or environment in development).
# SANDBOX_API_TOKEN_FILE=/run/secrets/sandbox_api_token
# SANDBOX_MAX_OUTPUT_BYTES: v2 code default; see docs/v2-spec.md §11.1.
SANDBOX_MAX_OUTPUT_BYTES=65536
# SANDBOX_MAX_CONCURRENT: v2 code default; see docs/v2-spec.md §11.1.
SANDBOX_MAX_CONCURRENT=2
# SANDBOX_TIMEOUT_MAX: v2 code default; see docs/v2-spec.md §11.1.
SANDBOX_TIMEOUT_MAX=300

# --- Browser (M6; unavailable until implemented) ---
# BROWSER_ENABLED: v2 code default; see docs/v2-spec.md §11.1.
BROWSER_ENABLED=false
# BROWSER_URL: v2 code default; see docs/v2-spec.md §11.1.
BROWSER_URL=http://10.77.4.40:7100
# BROWSER_API_TOKEN: read from a private mounted file (or environment in development).
# BROWSER_API_TOKEN_FILE=/run/secrets/browser_api_token
# BROWSER_MAX_TABS: v2 code default; see docs/v2-spec.md §11.1.
BROWSER_MAX_TABS=2
# BROWSER_ACTION_TIMEOUT_S: v2 code default; see docs/v2-spec.md §11.1.
BROWSER_ACTION_TIMEOUT_S=30
# BROWSER_NAV_TIMEOUT_S: v2 code default; see docs/v2-spec.md §11.1.
BROWSER_NAV_TIMEOUT_S=45
# BROWSER_VIEWPORT: v2 code default; see docs/v2-spec.md §11.1.
BROWSER_VIEWPORT=1280x800
# BROWSER_CHROMIUM_SANDBOX: v2 code default; see docs/v2-spec.md §11.1.
BROWSER_CHROMIUM_SANDBOX=false
# BROWSER_ALLOW_PRIVATE_HOSTS: v2 code default; see docs/v2-spec.md §11.1.
BROWSER_ALLOW_PRIVATE_HOSTS=

# --- Screen and sign-in (M7; unavailable until implemented) ---
# SCREEN_ENABLED: v2 code default; see docs/v2-spec.md §11.1.
SCREEN_ENABLED=false
# VNC_PASSWORD: read from a private mounted file (or environment in development).
# VNC_PASSWORD_FILE=/run/secrets/vnc_password
# VNC_VIEW_PASSWORD: read from a private mounted file (or environment in development).
# VNC_VIEW_PASSWORD_FILE=/run/secrets/vnc_view_password
# SCREEN_SESSION_IDLE_MIN: v2 code default; see docs/v2-spec.md §11.1.
SCREEN_SESSION_IDLE_MIN=30
# APPROVAL_TIMEOUT_MIN: v2 code default; see docs/v2-spec.md §11.1.
APPROVAL_TIMEOUT_MIN=15
# JOB_APPROVAL_TIMEOUT_MIN: v2 code default; see docs/v2-spec.md §11.1.
JOB_APPROVAL_TIMEOUT_MIN=120
# MAX_PENDING_APPROVALS: v2 code default; see docs/v2-spec.md §11.1.
MAX_PENDING_APPROVALS=10
# SIGNIN_TIMEOUT_MIN: v2 code default; see docs/v2-spec.md §11.1.
SIGNIN_TIMEOUT_MIN=30

# --- Backups and audit (later M1 foundation PRs) ---
# Empty disables scheduled backups; scheduling arrives in a later M1 PR.
BACKUP_DIR=
# BACKUP_TIME: v2 code default; see docs/v2-spec.md §11.1.
BACKUP_TIME=03:30
# BACKUP_KEEP_DAILY: v2 code default; see docs/v2-spec.md §11.1.
BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY: v2 code default; see docs/v2-spec.md §11.1.
BACKUP_KEEP_WEEKLY=8
# BACKUP_WORKSPACE: v2 code default; see docs/v2-spec.md §11.1.
BACKUP_WORKSPACE=true
# BACKUP_WORKSPACE_KEEP: v2 code default; see docs/v2-spec.md §11.1.
BACKUP_WORKSPACE_KEEP=3
# BACKUP_WORKSPACE_MAX_MB: v2 code default; see docs/v2-spec.md §11.1.
BACKUP_WORKSPACE_MAX_MB=2048
# AUDIT_DETAIL_MAX_BYTES: v2 code default; see docs/v2-spec.md §11.1.
AUDIT_DETAIL_MAX_BYTES=8192
# LOG_LEVEL: v2 code default; see docs/v2-spec.md §11.1.
LOG_LEVEL=INFO
# Optional compose services remain unavailable at this stage; keep profiles empty.
COMPOSE_PROFILES=
